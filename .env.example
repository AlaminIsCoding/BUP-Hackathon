# LLM provider preset: openai | openrouter | gemini | ollama | custom
# The preset sets the default base URL, model, and key env var.
# Explicit LLM_BASE_URL / LLM_MODEL / LLM_API_KEY always override the preset.

# --- OpenRouter (recommended: cheap, reliable) ---
# Preset defaults to model deepseek/deepseek-v4.1-flash; set LLM_MODEL to override.
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=

# --- Other providers (uncomment a block to switch) ---
# LLM_PROVIDER=openai
# OPENAI_API_KEY=
#
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=
#
# LLM_PROVIDER=ollama          # local, no key required
# LLM_MODEL=llama3.2
#
# LLM_PROVIDER=custom
# LLM_BASE_URL=https://my-gateway.example/v1

# Generic API key override for any provider (never logged or echoed).
LLM_API_KEY=

# Uvicorn bind port.
PORT=8000
